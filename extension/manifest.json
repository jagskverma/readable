{
  "manifest_version": 3,
  "name": "Readable",
  "version": "1.6.0",
  "description": "Rewrite web prose with ChatGPT, an API key, or local Ollama.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Rewrite page \u00b7 click again to restore"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "key": ""
}
